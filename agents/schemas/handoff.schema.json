{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-handoff.schema.json",
  "title": "Agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "requirement_ids",
    "summary",
    "changed_files",
    "checks",
    "evidence",
    "residual_risks",
    "human_approval_pending"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "enum": [
        "orchestrator",
        "architecture_security",
        "backend_integrations",
        "frontend_accessibility",
        "qa_devsecops"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"type": "string", "enum": ["passed", "failed", "not_run"]},
          "details": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "human_approval_pending": {"type": "boolean"},
    "approval_reason": {"type": ["string", "null"], "maxLength": 1000}
  },
  "allOf": [
    {
      "if": {"properties": {"human_approval_pending": {"const": true}}},
      "then": {"required": ["approval_reason"], "properties": {"approval_reason": {"type": "string", "minLength": 1}}}
    }
  ]
}

